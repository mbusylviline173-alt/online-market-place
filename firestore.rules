rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Master catch-all deny by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Identity helpers
    function isSignedIn() {
      return request.auth != null;
    }

    // Master Administrator verification
    function isAdmin() {
      return isSignedIn() && request.auth.uid == 'PVJI9qMFKlYUwPsA2M1petwZYvE3';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Users Collection:
    // Admin user ID has full read/write access to all user records.
    // Non-admin users are strictly locked down to their own profile document only.
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Files Collection:
    // Admin user ID has read, list, and delete access to all uploaded files.
    // Non-admin users can only create, read, list, and delete their own files.
    match /files/{fileId} {
      allow get: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // Products Collection:
    // Public marketplace shoppers can view all listed goods on the main section.
    // Signed-in merchants and administrators can publish and manage catalog products.
    match /products/{productId} {
      allow read: if true;
      allow create: if isSignedIn() || isAdmin();
      allow update: if isSignedIn() || isAdmin();
      allow delete: if isSignedIn() || isAdmin();
    }
  }
}
